@model RegisterVm
@{ViewData["Title"]="Register";}
<div class="row justify-content-center"><div class="col-md-6"><div class="card p-4"><h2 class="fw-bold">Create your account</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>@foreach(var f in new[]{"Name","Email","Password"}){<label class="form-label" for="@f">@f</label><input class="form-control mb-3" id="@f" name="@f" type="@(f=="Password"?"password":"text")" value="@(f=="Name"?Model.Name:f=="Email"?Model.Email:"")"/>}<label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select mb-3"><option>Participant</option><option>Organiser</option></select><button class="btn btn-warning w-100">Register</button></form></div></div></div>

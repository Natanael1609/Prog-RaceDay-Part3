@{ViewData["Title"]="Event details";var e=ViewBag.Event;var cats=ViewBag.Categories;}<div class="card p-4"><h1 class="fw-bold">@(e.TryGetProperty("name",out var n)?n.ToString():"Event details")</h1><p>@(e.TryGetProperty("description",out var d)?d.ToString():"")</p><p>📍 @(e.TryGetProperty("location",out var l)?l.ToString():"")</p><p>📅 @(e.TryGetProperty("date",out var dt)?dt.ToString():"")</p><h4>Available categories</h4>@if(cats.ValueKind==JsonValueKind.Array){@foreach(var c in cats.EnumerateArray()){<form asp-action="Enrol" method="post" class="border rounded p-3 mb-2"><input type="hidden" name="EventId" value="@(e.TryGetProperty("id",out var id)?id.ToString():"0")"/><input type="hidden" name="CategoryId" value="@(c.TryGetProperty("id",out var cid)?cid.ToString():"0")"/><strong>@(c.TryGetProperty("name",out var cn)?cn.ToString():"Category")</strong><button class="btn btn-warning btn-sm float-end">Enrol</button></form>}}</div>

@model ProfileVm
@{ViewData["Title"]="My profile";}<h1 class="fw-bold">My profile</h1><div class="card p-4"><form method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control mb-3"/><label asp-for="Email"></label><input asp-for="Email" class="form-control mb-3"/><label asp-for="Phone"></label><input asp-for="Phone" class="form-control mb-3"/><label class="form-label">Profile picture</label><input asp-for="ProfilePicture" type="file" accept="image/*" class="form-control mb-3"/><button class="btn btn-warning">Update profile</button></form></div>

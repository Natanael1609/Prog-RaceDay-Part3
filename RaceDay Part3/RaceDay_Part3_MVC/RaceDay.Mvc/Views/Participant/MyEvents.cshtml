@{ViewData["Title"]="My events";var data=ViewBag.Data;}<h1 class="fw-bold">My enrolments</h1>@if(data.ValueKind==JsonValueKind.Array){<div class="card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var e in data.EnumerateArray()){<tr><td>@(e.TryGetProperty("eventName",out var n)?n.ToString():"")</td><td>@(e.TryGetProperty("eventDate",out var d)?d.ToString():"")</td><td>@(e.TryGetProperty("categoryName",out var c)?c.ToString():"")</td><td><span class="badge status-confirmed">@(e.TryGetProperty("status",out var s)?s.ToString():"Pending")</span></td></tr>}</tbody></table></div>}else{<p>No enrolments returned.</p>}

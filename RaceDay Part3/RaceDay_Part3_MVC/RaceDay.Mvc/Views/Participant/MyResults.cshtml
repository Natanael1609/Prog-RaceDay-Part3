@{ViewData["Title"]="My results";var data=ViewBag.Data;}<h1 class="fw-bold">My race results</h1>@if(data.ValueKind==JsonValueKind.Array){<div class="card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var e in data.EnumerateArray()){<tr><td>@(e.TryGetProperty("eventName",out var n)?n.ToString():"")</td><td>@(e.TryGetProperty("eventDate",out var d)?d.ToString():"")</td><td>@(e.TryGetProperty("categoryName",out var c)?c.ToString():"")</td><td>@(e.TryGetProperty("finishTime",out var t)?t.ToString():"")</td><td>@(e.TryGetProperty("position",out var p)?p.ToString():"")</td></tr>}</tbody></table></div>}else{<p>Your published results will appear here.</p>}

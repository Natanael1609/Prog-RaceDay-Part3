@{ViewData["Title"]="Event enrolments";var data=ViewBag.Data;}<h1 class="fw-bold">Event enrolments</h1>@if(data.ValueKind==JsonValueKind.Array){<div class="card p-3"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Result</th></tr></thead><tbody>@foreach(var e in data.EnumerateArray()){var id=e.TryGetProperty("id",out var i)?i.ToString():"0";<tr><td>@(e.TryGetProperty("participantName",out var n)?n.ToString():"")</td><td>@(e.TryGetProperty("categoryName",out var c)?c.ToString():"")</td><td><span class="badge status-pending">@(e.TryGetProperty("status",out var s)?s.ToString():"Pending")</span></td><td><a asp-action="Result" asp-route-enrolmentId="@id">Enter result</a></td></tr>}</tbody></table></div>}else{<div class="alert alert-info">No enrolments returned by API.</div>}

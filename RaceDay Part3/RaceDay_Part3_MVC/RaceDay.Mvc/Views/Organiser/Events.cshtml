@{ViewData["Title"]="Manage events";var data=ViewBag.Events;}<div class="d-flex justify-content-between"><h1 class="fw-bold">Manage events</h1><a class="btn btn-warning" asp-action="Create">Create event</a></div>
@if(data.ValueKind==JsonValueKind.Array){<div class="table-responsive card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Actions</th></tr></thead><tbody>@foreach(var e in data.EnumerateArray()){var id=e.TryGetProperty("id",out var i)?i.ToString():"0";<tr><td>@(e.TryGetProperty("name",out var n)?n.ToString():"")</td><td>@(e.TryGetProperty("date",out var d)?d.ToString():"")</td><td>@(e.TryGetProperty("location",out var l)?l.ToString():"")</td><td><a asp-action="Edit" asp-route-id="@id">Edit</a> · <a asp-action="Enrolments" asp-route-eventId="@id">Enrolments</a> · <a asp-action="Category" asp-route-eventId="@id">Add category</a><form asp-action="Delete" method="post" class="d-inline"><input type="hidden" name="id" value="@id"/><button class="btn btn-sm btn-link text-danger">Delete</button></form></td></tr>}</tbody></table></div>}else{<div class="alert alert-info">No events returned. Check the API route mapping in README.</div>}

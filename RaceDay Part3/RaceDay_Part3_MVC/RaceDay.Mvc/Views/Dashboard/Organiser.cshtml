@{ViewData["Title"]="Organiser dashboard";var events=ViewBag.Events;}
<h1 class="fw-bold">Organiser dashboard</h1><p class="text-muted">Your event overview and race operations.</p><a class="btn btn-warning mb-3" asp-controller="Organiser" asp-action="Create">＋ Create event</a><a class="btn btn-outline-dark mb-3 ms-2" asp-controller="Organiser" asp-action="Events">Manage events</a>
@if(events.ValueKind==JsonValueKind.Array){<div class="row g-3">@foreach(var e in events.EnumerateArray()){<div class="col-md-4"><div class="card p-3"><h5>@(e.TryGetProperty("name",out var n)?n.ToString():"Event")</h5><p>@(e.TryGetProperty("date",out var d)?d.ToString():"")</p><a asp-controller="Organiser" asp-action="Enrolments" asp-route-eventId="@(e.TryGetProperty("id",out var id)?id.ToString():"0")">View enrolments</a></div></div>}</div>}else{<div class="alert alert-info">Event summary will appear when the API returns your organiser events.</div>}

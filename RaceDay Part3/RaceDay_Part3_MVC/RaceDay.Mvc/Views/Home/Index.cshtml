@{ViewData["Title"]="Upcoming events"; var data=ViewBag.Events; }
<section class="hero mb-4"><span class="badge text-bg-warning mb-3">YOUR NEXT FINISH LINE</span><h1 class="display-4 fw-bold">Make every race day count.</h1><p class="lead">Discover events, choose your challenge and track your results.</p><a class="btn btn-warning btn-lg" asp-controller="Account" asp-action="Register">Get started</a></section>
<form method="get" class="row g-2 mb-4"><div class="col-md-8"><input name="search" class="form-control" placeholder="Search events or locations" value="@ViewBag.Search"/></div><div class="col-md-3"><select name="eventType" class="form-select"><option value="">All event types</option><option>Road</option><option>Trail</option><option>Track</option></select></div><div class="col-md-1"><button class="btn btn-dark w-100">Go</button></div></form>
@if(ViewBag.ApiUnavailable==true){<div class="alert alert-warning">The event service is currently unavailable. Start the Part 2 API and check Api:BaseUrl in appsettings.json.</div>}
@if(data.ValueKind==JsonValueKind.Array){<div class="row g-3">@foreach(var e in data.EnumerateArray()){<div class="col-md-4"><div class="card h-100"><div class="card-body"><h5 class="fw-bold">@((e.TryGetProperty("name",out var n)?n.ToString():"Race event"))</h5><p>@(e.TryGetProperty("description",out var d)?d.ToString():"")</p><p class="text-secondary mb-1">📍 @(e.TryGetProperty("location",out var l)?l.ToString():"")</p><p class="text-secondary">📅 @(e.TryGetProperty("date",out var dt)?dt.ToString():"")</p><a class="btn btn-outline-dark" asp-controller="Participant" asp-action="Details" asp-route-id="@(e.TryGetProperty("id",out var id)?id.ToString():"0")">View event</a></div></div></div>}</div>}else{<p class="text-muted">No event data was returned by the API.</p>}

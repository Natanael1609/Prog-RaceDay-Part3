<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RACEDAY</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto">
<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>
@if(Context.Session.GetString("AccessToken")!=null){<li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a></li>}else{<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>}<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Sign out</a></li>}else{<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li><li class="nav-item"><a class="btn btn-warning ms-lg-2" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>}
</ul></div></div></nav><main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-warning">@TempData["Error"]</div>}@RenderBody()</main><footer class="py-4 mt-5 bg-dark text-white text-center">RaceDay • Train. Compete. Finish strong.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
